# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
# Route API calls through Next.js proxy (httpOnly cookies). Set false to use Bearer + localStorage only.
NEXT_PUBLIC_USE_API_PROXY=true
# Must match backend ACCESS_TOKEN_EXPIRE_MINUTES (access cookie max-age in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=120
