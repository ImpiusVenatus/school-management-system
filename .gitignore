# School Management System - Monorepo (backend + frontend)

# === Backend (Python/FastAPI) ===
backend/venv/
backend/.venv/
backend/env/
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/*$py.class
backend/**/*$py.class
backend/*.so
backend/build/
backend/dist/
backend/*.egg-info/
backend/**/*.egg-info/
backend/*.egg
backend/uploads/

# === Frontend (Next.js) ===
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel/

# === Environment & secrets (both) ===
.env
.env.local
.env.*.local
!backend/.env.example
!frontend/.env.local.example

# === IDE & OS ===
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.pem

# === Logs & debug ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# === Alembic ===
backend/alembic/versions/*.pyc
